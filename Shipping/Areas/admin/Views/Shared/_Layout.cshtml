@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = userName.Length > 0 ? char.ToUpper(userName[0]).ToString() : "A";

    string Active(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Shipping Admin</title>

    <!-- Template styles -->
    <link rel="stylesheet" href="~/Admin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/Admin/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/Admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Admin/assets/css/demo_2/style.css">
    <link rel="shortcut icon" href="~/Admin/assets/images/favicon.png" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

    <!-- Small custom touches -->
    <style>
        .brand-text {
            font-weight: 700;
            font-size: 1.35rem;
            color: #9a55ff;
            text-decoration: none;
            white-space: nowrap;
        }
        .brand-text i { margin-right: 6px; }

        .avatar-initial {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(to right, #da8cff, #9a55ff);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
        }
        .sidebar .nav-profile-image .avatar-initial { width: 45px; height: 45px; }

        .sidebar .nav-profile .nav-profile-text span {
            display: block;
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>

    @RenderSection("Styles", false)
</head>
<body>
    <div class="container-scroller">

        <!-- ================= Top navbar ================= -->
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <a class="navbar-brand brand-logo brand-text" asp-area="admin" asp-controller="Home" asp-action="Index">
                    <i class="mdi mdi-truck-delivery"></i>Shipping
                </a>
                <a class="navbar-brand brand-logo-mini brand-text" asp-area="admin" asp-controller="Home" asp-action="Index">
                    <i class="mdi mdi-truck-delivery"></i>
                </a>
            </div>

            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>

                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-profile-img">
                                <span class="avatar-initial">@initial</span>
                                <span class="availability-status online"></span>
                            </div>
                            <div class="nav-profile-text">
                                <p class="mb-1">@userName</p>
                            </div>
                        </a>
                        <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown">
                            <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="mdi mdi-web me-2 text-success"></i> View website
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item">
                                    <i class="mdi mdi-logout me-2 text-primary"></i> Sign out
                                </button>
                            </form>
                        </div>
                    </li>
                </ul>

                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">

            <!-- ================= Sidebar ================= -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item nav-profile">
                        <a href="#" class="nav-link" onclick="return false;">
                            <div class="nav-profile-image">
                                <span class="avatar-initial">@initial</span>
                                <span class="login-status online"></span>
                            </div>
                            <div class="nav-profile-text d-flex flex-column">
                                <span class="font-weight-bold mb-2" title="@userName">@userName</span>
                                <span class="text-secondary text-small">Administrator</span>
                            </div>
                            <i class="mdi mdi-bookmark-check text-success nav-profile-badge"></i>
                        </a>
                    </li>

                    <li class="nav-item @Active("Home")">
                        <a class="nav-link" asp-area="admin" asp-controller="Home" asp-action="Index">
                            <span class="menu-title">Dashboard</span>
                            <i class="mdi mdi-home menu-icon"></i>
                        </a>
                    </li>

                    <li class="nav-item @Active("ShippingTypes")">
                        <a class="nav-link" asp-area="admin" asp-controller="ShippingTypes" asp-action="Index">
                            <span class="menu-title">Shipping Types</span>
                            <i class="mdi mdi-truck-fast menu-icon"></i>
                        </a>
                    </li>

                    <li class="nav-item @Active("Countres")">
                        <a class="nav-link" asp-area="admin" asp-controller="Countres" asp-action="Index">
                            <span class="menu-title">Countries</span>
                            <i class="mdi mdi-earth menu-icon"></i>
                        </a>
                    </li>

                    <li class="nav-item @Active("Citys")">
                        <a class="nav-link" asp-area="admin" asp-controller="Citys" asp-action="Index">
                            <span class="menu-title">Citys</span>
                            <i class="mdi mdi-earth menu-icon"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            @RenderBody()

            <!-- ================= Footer ================= -->
            <footer class="footer">
                <div class="d-sm-flex justify-content-center justify-content-sm-between">
                    <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                        &copy; 2026 Shipping. All rights reserved.
                    </span>
                </div>
            </footer>
        </div>
        <!-- main-panel ends -->
    </div>
    <!-- page-body-wrapper ends -->
</div>

<!-- ================= Scripts ================= -->
<script src="~/Admin/assets/vendors/js/vendor.bundle.base.js"></script>

<!-- Validation -->
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<!-- Template behaviour (sidebar toggle, collapse) -->
<script src="~/Admin/assets/js/off-canvas.js"></script>
<script src="~/Admin/assets/js/hoverable-collapse.js"></script>
<script src="~/Admin/assets/js/misc.js"></script>

<!-- Project scripts -->
<script src="~/Admin/assets/js/site.js"></script>
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<script src="~/App/Shared/Alerts.js"></script>

@RenderSection("Scripts", required: false)
</body>
</html>
