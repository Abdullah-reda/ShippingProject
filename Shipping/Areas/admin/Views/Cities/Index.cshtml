@model List<CityDto>

@section Styles
{
    <!-- Plugin css for this page -->
    <link rel="stylesheet" href="~/admin/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
    <!-- End plugin css for this page -->
}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title"> @Labels.Cities </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">@Labels.Cities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Data table</li>
            </ol>
        </nav>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="card">
        <div class="card-body">
            <h4 class="card-title"></h4>
            <div class="row">
                <div class="col-12">
                </div>
                <div class="col-12">

                    <a href="/Admin/Cities/Edit" class="btn btn-success btn-fw">@Actions.AddNew</a>

                    <table id="order-listing" class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Labels.NameAr </th>
                                <th>@Labels.NameEn </th>
                                <th>@Shipping.CountryName </th>
                                <th>@Labels.Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Citites in Model)
                            {
                                <tr>
                                    <td class="col-md-8"> @Citites.CityAname</td>
                                    <td class="col-md-8"> @Citites.CityEname</td>
                                    <td class="col-md-8"> @Citites.CountryAname</td>

                                     <td class="col-md-4">
                                        <a asp-area="Admin"
                                           asp-controller="Cities"
                                           asp-action="Edit"
                                           asp-route-Id="@Citites.Id"
                                           class="btn btn-info btn-fw">
                                            @Actions.Edit
                                        </a>

                                        <button type="button"
                                                class="btn btn-danger btn-fw delete-btn"
                                                data-id="@Citites.Id">
                                            @Actions.Delete
                                        </button>
                                    
                                </tr>
                            }

                        </tbody>
                    </table>
                      <form id="deleteForm"
                          asp-area="Admin"
                          asp-controller="Cities"
                          asp-action="Delete"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="deleteId"
                               name="id" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <script src="~/Admin/vendors/js/vendor.bundle.base.js"></script>

    <script src="~/Admin/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/Admin/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    <script src="~/Admin/js/data-table.js"></script>

    <script>
        $(document).ready(function () {
            $('.delete-btn').on('click', function () {
                const id = $(this).data('id');

                alert.ConfirmDelete(function (result) {
                    $('#deleteId').val(id);
                    $('#deleteForm').submit();
                });
            });
        });
    </script>

    @if (TempData["MessageType"] != null)
    {
        <script>
            $(document).ready(function () {
                const messageType = @TempData["MessageType"];

                switch (messageType) {
                    case 1:
                        alert.Success(
                            '@Messages.SaveSuccessTitle',
                            '@Messages.SaveSuccessMessage'
                        );
                        break;

                    case 2:
                        alert.Error(
                            '@Messages.SaveFailedTitle',
                            '@Messages.SaveFailedMessage'
                        );
                        break;

                    case 3:
                        alert.Success(
                            '@Messages.DeleteSuccessTitle',
                            '@Messages.DeleteSucessMessage'
                        );
                        break;

                    case 4:
                        alert.Error(
                            '@Messages.DeleteFailedTitle',
                            '@Messages.DeleteFailedMessage'
                        );
                        break;

                    default:
                        console.log("Unknown message type");
                        break;
                }
            });
        </script>
    }
}
<!-- content-wrapper ends -->
